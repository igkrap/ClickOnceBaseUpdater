<Window x:Class="MainApplication.UpdateToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="300" Height="160">
    <Border Background="#FF1F2937" CornerRadius="12" Padding="16" Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="업데이트가 있습니다" Foreground="White" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Margin="0,8,0,12" Text="지금 업데이트를 진행할까요?" Foreground="#D1D5DB" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Margin="0,0,8,0" Click="OnYesClick">예</Button>
                <Button Width="80" Click="OnNoClick">아니오</Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
